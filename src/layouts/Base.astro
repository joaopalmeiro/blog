---
import "../styles/global.css";

const { title, description } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <!--
    Interested in the source code for this website? You can check it here:
    https://github.com/joaopalmeiro/blog
  -->
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="author" content="João Palmeiro" />
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="fediverse:creator" content="@joaopalmeiro@ciberlandia.pt" />
  </head>

  <body class="mx-auto max-w-prose px-6 py-12 text-base text-gray-900">
    <slot />
  </body>
</html>
