---
import type { CodeLanguage } from "astro";
import { Code } from "astro:components";

interface Props {
  code: string;
  lang: CodeLanguage;
}

const { code, lang } = Astro.props;
---

<Code
  code={code}
  theme="min-light"
  lang={lang}
  class="border-y border-dashed border-gray-400 py-2 [font-variant-ligatures:none] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
/>
