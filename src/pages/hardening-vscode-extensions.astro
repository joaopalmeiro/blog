---
import { Code } from "astro:components";
import { basename } from "node:path";

import { posts } from "../data/posts";
import Layout from "../layouts/Base.astro";
import { dateFormatter } from "../utils";

const id = basename(import.meta.url, ".astro");
const post = posts.find((p) => p.id === id);

if (!post) throw new Error(`No post found with id "${id}".`);

const extensionsSnippet = `
{
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false
}
`.trim();
---

<Layout title="TODO" description="TODO">
  <header class="mb-12">
    <a
      class="font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
      aria-label="Homepage"
      href="/">Patches</a
    >
  </header>

  <main>
    <article>
      <header>
        <h1 class="text-xl font-medium">{post.title}</h1>

        <p>
          Published on <time datetime={post.createdAt}>{dateFormatter.format(new Date(post.createdAt))}</time>.{
            post.lastUpdatedAt && (
              <>
                {" "}
                Last updated on{" "}
                <time datetime={post.lastUpdatedAt}>{dateFormatter.format(new Date(post.lastUpdatedAt))}</time>.
              </>
            )
          }
        </p>
      </header>

      <p>TODO</p>

      <Code
        code={extensionsSnippet}
        theme="catppuccin-latte"
        lang="json"
        class="border-y border-dashed border-[#9ca0b0] p-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
      />
    </article>
  </main>
</Layout>
